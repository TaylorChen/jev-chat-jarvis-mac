# jev-jarvis 配置示例
# 变量名都是通用约定。推荐放 ~/.config/jev-jarvis/env（仓库之外，不可能被提交）；
# 放这里（项目根目录 .env）也可以，已在 .gitignore 中排除。

# ── 判断层：TypeSafe Jev（无嘴模型，只输出意图/风险，不写文本）────────────
# 填了就用官方 Jev；不填则用本地开源复刻 decider-2b（首次运行下载约 7GB）
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# ── 生成层：写回复候选（Jev 写不了文本，这层必须另配）──────────────────
# 任意 OpenAI 兼容端点
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# 如果服务商是 Anthropic 兼容格式，改用这一组（OPENAI_* 有 key 时优先）
#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
#ANTHROPIC_MODEL=glm-4-flash

# 通用模型名兜底（两家共用）
#LLM_MODEL=

# ── 可选：自定义「话术」（面板下拉框里会多出来）──────────────────────────
# 用 | 分隔多条，每条「名字=说明」；同名的会覆盖内置话术。
# 说明是直接喂给模型的指令，写清「什么语气 + 别变成什么」比只写形容词管用。
# export JEV_TONES="摸鱼大师=像资深摸鱼选手，把活推得漂亮又不失礼|孙子兵法=用兵法比喻说话"

# ── 可选：启动时打开「YOLO 检测框」────────────────────────────────────
# 把每次 OCR 认出的消息用彩框实时框在微信窗口上（对方/我分色+真实置信度，
# 被判断那条带意图·风险标签）。点击穿透、不进抓图。菜单栏 J 图标随时开关。
#JEV_BOXES=1

# ── 可选：数据源（消息从哪来）────────────────────────────────────────
# db（默认）= 只读打开微信自己的加密库：消息更全（真实上下文、不漏屏外消息）、
#             不需要屏幕录制权限；但要先提取密钥：运行 tools/extract_wechat_keys.command
#             （要 sudo 给微信 ad-hoc 重签名，首次还要在微信里退出登录再登录一次）。
#             没提取过密钥就自动退回 ocr，并在启动时提示你跑那条命令。
# ocr        = 截取微信窗口 + Vision 识别：不需要额外权限、不接触微信数据文件。
# 也可以在「模型设置 → 感知 · 数据源」里切换；临时覆盖：
#   uv run python src/hud.py --source ocr
#JEV_SOURCE=db

# 密钥文件位置（留空 = 应用数据目录 ~/Library/Application Support/jev-jarvis/wechat_keys.json）
#JEV_KEYS_FILE=

# db 模式下要分析哪些会话：follow（默认，你最近打开过的那个）/ all（所有会话，很吵）
#JEV_DB_WATCH=follow

# 判断/生成用多少条上下文。不填时：数据库直读用读到的**全部**真实历史（默认 100 条，
# 约 4k 字符 / ~2k tokens），读屏用按轮次的默认（判断 2 条、生成 8 条）。
# 填 0 以外的数字就按条数走（上限 400）。旧的 JEV_DB_HISTORY=1 仍认，等价于「用全部读到」。
#JEV_CONTEXT_MESSAGES=100

# 微信 db_storage 路径（默认自动定位；多账号或非默认安装位置时才需要）
#JEV_LIVE_DIR=

# 解密快照目录（历史会话分析工具用；默认应用数据目录下的 decrypted/）
#JEV_DB_DIR=
